{
  "name": "@cloudflare/config",
  "version": "0.23.0",
  "description": "Definitions and utilities for configuring Cloudflare Workers and related products. This is not yet stable enough for external use — APIs may change without notice.",
  "homepage": "https://github.com/cloudflare/workers-sdk/tree/main/packages/config#readme",
  "bugs": {
    "url": "https://github.com/cloudflare/workers-sdk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudflare/workers-sdk.git",
    "directory": "packages/config"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./public": {
      "types": "./dist/public.d.mts",
      "import": "./dist/public.mjs"
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "ts-dedent": "^2.2.0",
    "tsdown": "0.16.3",
    "typescript": "5.8.3",
    "vitest": "4.1.0",
    "@cloudflare/workers-tsconfig": "0.0.0",
    "@cloudflare/workers-utils": "0.46.0"
  },
  "workers-sdk": {
    "prerelease": true
  },
  "scripts": {
    "build": "tsdown",
    "check:type": "tsc",
    "dev": "tsdown --watch",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  }
}