{
  "name": "@cloudflare/codemods",
  "version": "0.4.0",
  "description": "Codemods for upgrading Cloudflare developer projects",
  "keywords": [
    "cloudflare",
    "codemod",
    "migration",
    "workers"
  ],
  "homepage": "https://github.com/cloudflare/workers-sdk/tree/main/packages/codemods#readme",
  "bugs": {
    "url": "https://github.com/cloudflare/workers-sdk/issues"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudflare/workers-sdk.git",
    "directory": "packages/codemods"
  },
  "bin": {
    "cloudflare-codemods": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "22.15.17",
    "tinyglobby": "0.2.16",
    "tsup": "8.3.0",
    "typescript": "5.8.3",
    "vitest": "4.1.0",
    "@cloudflare/cli-shared-helpers": "0.2.2",
    "@cloudflare/workers-tsconfig": "0.0.0",
    "@cloudflare/workers-utils": "0.45.1",
    "@cloudflare/shared-ast-primitives": "1.1.0"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "workers-sdk": {
    "prerelease": true
  },
  "scripts": {
    "build": "tsup",
    "check:type": "tsc -p ./tsconfig.json",
    "deploy": "echo 'no deploy'",
    "test": "vitest",
    "test:ci": "vitest run",
    "type:tests": "tsc -p ./test/tsconfig.json"
  }
}