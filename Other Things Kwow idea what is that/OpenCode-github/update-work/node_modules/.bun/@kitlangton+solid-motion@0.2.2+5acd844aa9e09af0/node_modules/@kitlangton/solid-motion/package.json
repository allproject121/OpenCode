{
  "name": "@kitlangton/solid-motion",
  "version": "0.2.2",
  "description": "Motion for SolidJS: springs, presence, drag and gestures on Motion's engine.",
  "license": "MIT",
  "author": "Kit Langton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitlangton/solid-motion.git",
    "directory": "packages/solid-motion"
  },
  "keywords": [
    "solid",
    "solidjs",
    "motion",
    "animation",
    "spring",
    "presence",
    "gestures",
    "drag"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/source/index.jsx",
      "node": "./dist/server.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.source.json && vite build && SOLID_MOTION_TARGET=server vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "motion-dom": "14.0.0",
    "motion-utils": "14.0.0"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "solid-js": "^1.8.0",
    "typescript": "^5.4.0",
    "vite": "^6.4.2",
    "vite-plugin-solid": "^2.11.0"
  }
}
