{
  "name": "@textjs/core",
  "version": "1.6.1",
  "description": "Text.js core engine: CellBuffer, Yoga layout scene graph, text measurement, input and console drivers.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://textjs.org/docs/turbolog-engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/textjs.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/anomalyco/textjs/issues",
  "keywords": [
    "textjs",
    "console",
    "devtools",
    "tui",
    "yoga",
    "layout",
    "renderer"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "default": "./dist/experimental.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./yoga.wasm": "./yoga.wasm"
  },
  "imports": {
    "#yoga-loader": {
      "workerd": "./dist/yoga-loader.workerd.js",
      "@textjs/client": "./dist/yoga-loader.browser.js",
      "default": "./dist/yoga-loader.inline.js"
    },
    "#bidi-loader": {
      "@textjs/client": "./dist/bidi-loader.browser.js",
      "default": "./dist/bidi-loader.inline.js"
    }
  },
  "files": [
    "dist",
    "src",
    "yoga.wasm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && bun ../../scripts/esm-specifiers.ts dist",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "bun test",
    "bench": "bun test test/perf.test.ts"
  },
  "dependencies": {
    "yoga-layout": "3.2.1"
  }
}
