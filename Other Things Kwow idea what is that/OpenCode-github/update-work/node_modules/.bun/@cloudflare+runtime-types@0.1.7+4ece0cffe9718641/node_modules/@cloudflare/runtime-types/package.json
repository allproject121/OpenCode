{
  "name": "@cloudflare/runtime-types",
  "version": "0.1.7",
  "description": "Utilities for generating Cloudflare Workers runtime types from compatibility dates and flags. This is not yet stable enough for external use — APIs may change without notice.",
  "homepage": "https://github.com/cloudflare/workers-sdk/tree/main/packages/runtime-types#readme",
  "bugs": {
    "url": "https://github.com/cloudflare/workers-sdk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudflare/workers-sdk.git",
    "directory": "packages/runtime-types"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "workerd": "1.20261001.1",
    "miniflare": "5.20261001.0-alpha"
  },
  "devDependencies": {
    "@types/node": "22.15.17",
    "tsdown": "0.16.3",
    "typescript": "5.8.3",
    "vitest": "4.1.0",
    "@cloudflare/workers-tsconfig": "0.0.0",
    "@cloudflare/workers-utils": "0.45.1"
  },
  "workers-sdk": {
    "prerelease": true
  },
  "scripts": {
    "build": "tsdown",
    "check:type": "tsc",
    "dev": "tsdown --watch",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  }
}